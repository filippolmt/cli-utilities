# Copy to .env in this directory and fill in. .env is gitignored — never commit
# real credentials. Each CLI in this repo keeps its own .env.
#
# Load it into your shell with:
#   set -a; . ./.env; set +a
#
# The CLI reads environment variables, not this file, so anything already
# exported in your shell wins over what you put here.

# Required. A FRITZ!Box with a single user accepts a password-only login.
FRITZBOX_PASSWORD=

# Only needed when the box has more than one user.
FRITZBOX_USERNAME=

# Router origin. Defaults to http://fritz.box when unset. Do NOT add the TR-064
# port here: the CLI switches to 49000 for TR-064 on its own.
FRITZBOX_ADDRESS=

# Session id minted by `fritzbox-pp-cli auth login`. Leave empty; the CLI fills
# it in and refreshes it when it expires.
FRITZBOX_SID=

# Optional. Path to config.toml, and where the cache, database and state live.
FRITZBOX_CONFIG=
FRITZBOX_HOME=

# Before anything works, enable TR-064 on the router:
#   Home Network > Network > Network Settings > Allow access for applications
